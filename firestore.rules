rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email — full access to all collections
    function isAdmin() {
      return request.auth != null 
             && request.auth.token.email == 'goureesh3690@gmail.com';
    }

    // Device bindings
    match /device_bindings/{docId} {
      // Admin: full access to all docs
      allow read, write: if isAdmin();
      // Signed-in users: can read/write their own email doc
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == docId.lower();
      // Any device: can read dev_ docs (for block check) and write new dev_ docs
      allow read: if docId.matches('dev_.*');
      allow create: if docId.matches('dev_.*');
      allow update: if docId.matches('dev_.*')
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastSeen', 'deviceName', 'appVersion']);
    }

    // Install tracking — any device can track installs
    match /installs/{deviceId} {
      allow read, write: if true;
    }

    // Testers collection
    match /testers/{email} {
      allow read: if isAdmin();
      allow read: if request.auth != null 
                  && request.auth.token.email.lower() == email.lower();
      allow write: if false;
    }

    // User data backup
    match /user_data/{email} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }
    match /user_data/{email}/chunks/{chunkId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }

    // Appointments
    match /appointments/{email} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }
    match /appointments/{email}/requests/{requestId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
