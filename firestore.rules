rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin email — full access to all collections
    function isAdmin() {
      return request.auth != null 
             && request.auth.token.email == 'goureesh3690@gmail.com';
    }

    // Device bindings — admin or own email
    match /device_bindings/{email} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }

    // Install tracking — any device can track installs
    match /installs/{deviceId} {
      allow read, write: if true;
    }

    // Testers collection
    match /testers/{email} {
      allow read: if isAdmin();
      allow read: if request.auth != null 
                  && request.auth.token.email.lower() == email.lower();
      allow write: if false;
    }

    // User data backup
    match /user_data/{email} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }
    match /user_data/{email}/chunks/{chunkId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }

    // Appointments
    match /appointments/{email} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }
    match /appointments/{email}/requests/{requestId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email.lower() == email.lower();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
